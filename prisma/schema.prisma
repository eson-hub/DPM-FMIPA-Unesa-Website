generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(ADMIN)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  articles      Article[]
  announcements Announcement[]

  @@map("users")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Article {
  id          Int             @id @default(autoincrement())
  title       String
  slug        String          @unique
  category    ArticleCategory
  author      User            @relation(fields: [authorId], references: [id])
  authorId    Int             @map("author_id")
  thumbnail   String?
  content     String
  isPublished Boolean         @default(false) @map("is_published")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("articles")
}

enum ArticleCategory {
  BERITA
  PUBLIKASI
  PENGUMUMAN
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model Agenda {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  eventDate   DateTime     @map("event_date")
  status      AgendaStatus @default(UPCOMING)
  location    String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("agendas")
}

enum AgendaStatus {
  UPCOMING
  DONE
}

model Regulation {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  filePath    String?  @map("file_path")
  externalUrl String?  @map("external_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("regulations")
}

model Commission {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  tasks       String?
  members     Member[]

  @@map("commissions")
}

model Member {
  id           Int         @id @default(autoincrement())
  name         String
  position     String
  photo        String?
  commission   Commission? @relation(fields: [commissionId], references: [id])
  commissionId Int?        @map("commission_id")
  isBph        Boolean     @default(false) @map("is_bph")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@map("members")
}

model Gallery {
  id        Int      @id @default(autoincrement())
  title     String?
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery")
}
